<Window x:Class="USBBlockManager.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="600" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="USB Block Manager" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusHeader}"
                       FontSize="16"
                       Foreground="#0066CC"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding StatusDescription}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Foreground="#444" />
        </StackPanel>

        <!-- Hardware ID -->
        <Border Grid.Row="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,16,0,12"
                Background="#F9F9F9">
            <StackPanel>
                <TextBlock Text="Hardware ID вашего компьютера:"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding HardwareIdText}"
                           FontFamily="Consolas"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#007700"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock Text="Отправьте этот код поставщику программы, чтобы получить файл лицензии."
                           FontSize="11"
                           Foreground="#666"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Кнопки активации -->
        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Загрузить из файла"
                        Command="{Binding LoadFromFileCommand}" />
                <Button Content="Вставить текст лицензии"
                        Command="{Binding PasteTextCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Скопировать Hardware ID"
                        Command="{Binding CopyHwidCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Справка -->
        <Border Grid.Row="3"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,16,0,0"
                Background="#F5F5F5">
            <StackPanel>
                <TextBlock Text="Как активировать:" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12">
                    <Run>1.</Run>
                    <Run>Скопируйте Hardware ID и отправьте поставщику.</Run>
                    <LineBreak />
                    <Run>2.</Run>
                    <Run>Получите файл </Run>
                    <Run FontFamily="Consolas">license.json</Run>
                    <Run>.</Run>
                    <LineBreak />
                    <Run>3.</Run>
                    <Run>Нажмите «Загрузить из файла» и выберите полученный файл.</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Нижние кнопки -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Продолжить пробный период"
                    Command="{Binding ContinueTrialCommand}"
                    Visibility="{Binding ShowTrialButton, Converter={StaticResource BoolToVis}}" />
            <Button Content="Выход"
                    Command="{Binding ExitCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>