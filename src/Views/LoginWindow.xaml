<Window x:Class="USBBlockManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="320" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <!-- Блок для первичной установки пароля -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsSetupVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Пароль администратора (минимум 6 символов):" Margin="0,0,0,4" />
            <PasswordBox x:Name="SetupPasswordBox"
                         PasswordChanged="SetupPasswordBox_OnPasswordChanged"
                         Margin="0,0,0,12" />
            <TextBlock Text="Повторите пароль:" Margin="0,0,0,4" />
            <PasswordBox x:Name="SetupConfirmBox"
                         PasswordChanged="SetupConfirmBox_OnPasswordChanged"
                         Margin="0,0,0,12" />
        </StackPanel>

        <!-- Блок для входа -->
        <StackPanel Grid.Row="2" Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Пароль администратора:" Margin="0,0,0,4" />
            <PasswordBox x:Name="LoginPasswordBox"
                         PasswordChanged="LoginPasswordBox_OnPasswordChanged"
                         Margin="0,0,0,12" />
        </StackPanel>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="3"
                   Text="{Binding Error}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding Error, Converter={StaticResource BoolToVis}}" />

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Войти"
                    Command="{Binding LoginCommand}"
                    Width="100" Height="30"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVis}}" />
            <Button Content="Установить пароль"
                    Command="{Binding SetupCommand}"
                    Width="140" Height="30"
                    Visibility="{Binding IsSetupVisible, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>